{
  "name": "@gestionresidencial/auth-client",
  "version": "0.1.0",
  "description": "Cliente de sesion compartido por los frontends de Gestion Residencial: CSRF, reintento tras refresh, servicio de autenticacion y guard de rutas.",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup && node ../../scripts/normalize-esm-imports.mjs dist",
    "test": "node --test tests/*.test.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@gestionresidencial/shared-ui": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tsup": "^8.5.0",
    "typescript": "^5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GestionResidencialPoli/gr-common-ui.git",
    "directory": "packages/auth-client"
  },
  "publishConfig": {
    "access": "public"
  }
}
