{
  "name": "gr-common-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "dev": "pnpm build:packages && next dev",
    "build": "pnpm build:packages && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "pnpm build:packages && next typegen && tsc --noEmit",
    "test": "node --test tests/*.test.mjs && pnpm -r --if-present test",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm build:packages && changeset publish"
  },
  "dependencies": {
    "@gestionresidencial/auth-client": "workspace:*",
    "@gestionresidencial/shared-ui": "workspace:*",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.3.4"
}
